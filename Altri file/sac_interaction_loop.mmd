graph TD
    subgraph "SAC Interaction Loop"
        style Env fill:#f9f,stroke:#333,stroke-width:2px
        style ReplayBuffer fill:#ccf,stroke:#333,stroke-width:2px

        Env(Environment) -- "State (s)" --> Actor;
        Actor -- "Action (a)" --> Env;
        Env -- "Reward (r), Next State (s')" --> ReplayBuffer(Replay Buffer);
        ReplayBuffer -- "Sampled Transitions" --> Critic;
        ReplayBuffer -- "Sampled Transitions" --> Actor;
        Critic -- "Evaluates action quality<br/>(provides policy gradient)" --> Actor;
    end