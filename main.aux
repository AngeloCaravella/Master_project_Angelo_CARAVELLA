\@writefile{lof}{\contentsline {figure}{\numberline {3.28}{\ignorespaces SAC:it behaves charging full some Evs and leaving others not being completely charge focused, instead others are used to gain profit }}{102}{figure.3.28}\protected@file@percent }
\newlabel{fig:Critic_profiles_advanced}{{3.28}{102}{SAC:it behaves charging full some Evs and leaving others not being completely charge focused, instead others are used to gain profit}{figure.3.28}{}}
