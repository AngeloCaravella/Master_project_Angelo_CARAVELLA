\@writefile{lof}{\contentsline {figure}{\numberline {3.9}{\ignorespaces Average profit generated per EV. This metric normalizes the total profit by the number of vehicles served, highlighting the economic efficiency of each control strategy on a per-user basis.}}{96}{figure.caption.106}\protected@file@percent }
\newlabel{fig:Critic_profit_per_ev}{{3.9}{96}{Average profit generated per EV. This metric normalizes the total profit by the number of vehicles served, highlighting the economic efficiency of each control strategy on a per-user basis}{figure.caption.106}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.10}{\ignorespaces Average State of Charge (SoC) of all connected EVs over time. RL and MPC agents maintain a lower average SoC during low-price periods to prepare for charging, while heuristics like AFAP charge aggressively upon arrival.}}{97}{figure.caption.107}\protected@file@percent }
\newlabel{fig:Critic_avg_soc}{{3.10}{97}{Average State of Charge (SoC) of all connected EVs over time. RL and MPC agents maintain a lower average SoC during low-price periods to prepare for charging, while heuristics like AFAP charge aggressively upon arrival}{figure.caption.107}{}}
\@writefile{toc}{\contentsline {subsubsection}{Grid Impact Analysis}{98}{section*.108}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.11}{\ignorespaces Grid load for heuristic algorithms. Both AFAP and ALAP show significant and prolonged periods of transformer overload, as they do not coordinate charging to respect grid limits.}}{98}{figure.caption.109}\protected@file@percent }
\newlabel{fig:Critic_overload_heuristics}{{3.11}{98}{Grid load for heuristic algorithms. Both AFAP and ALAP show significant and prolonged periods of transformer overload, as they do not coordinate charging to respect grid limits}{figure.caption.109}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.12}{\ignorespaces Grid load for MPC algorithms. The MPC controllers are enough effective at preventing overloads, keeping the total load just below the transformer's maximum capacity.}}{98}{figure.caption.110}\protected@file@percent }
\newlabel{fig:Critic_overload_mpc}{{3.12}{98}{Grid load for MPC algorithms. The MPC controllers are enough effective at preventing overloads, keeping the total load just below the transformer's maximum capacity}{figure.caption.110}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.13}{\ignorespaces Grid load for SAC and TQC RL algorithms. The SAC agents learn to respect the grid constraints better than TQC.}}{98}{figure.caption.111}\protected@file@percent }
\newlabel{fig:Critic_overload_rl1}{{3.13}{98}{Grid load for SAC and TQC RL algorithms. The SAC agents learn to respect the grid constraints better than TQC}{figure.caption.111}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.14}{\ignorespaces Grid load for DDPG-based RL algorithms. These agents also learn to avoid overloads, though some minor spikes can occasionally be seen during the learning process.}}{99}{figure.caption.112}\protected@file@percent }
\newlabel{fig:Critic_overload_rl2}{{3.14}{99}{Grid load for DDPG-based RL algorithms. These agents also learn to avoid overloads, though some minor spikes can occasionally be seen during the learning process}{figure.caption.112}{}}
\@writefile{toc}{\contentsline {subsubsection}{Individual EV Charging Profiles}{100}{section*.113}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3.15}{\ignorespaces Individual EV profiles for heuristic algorithms. AFAP charges immediately upon arrival, while ALAP waits until the last possible moment. Neither strategy responds to price signals.}}{100}{figure.caption.114}\protected@file@percent }
\newlabel{fig:Critic_profiles_heuristics}{{3.15}{100}{Individual EV profiles for heuristic algorithms. AFAP charges immediately upon arrival, while ALAP waits until the last possible moment. Neither strategy responds to price signals}{figure.caption.114}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3.16}{\ignorespaces The SAC tends to fully charge some EVs while leaving others partially charged, focusing instead on using certain vehicles to maximize profit.}}{100}{figure.caption.115}\protected@file@percent }
\newlabel{fig:Critic_profiles_advanced}{{3.16}{100}{The SAC tends to fully charge some EVs while leaving others partially charged, focusing instead on using certain vehicles to maximize profit}{figure.caption.115}{}}
